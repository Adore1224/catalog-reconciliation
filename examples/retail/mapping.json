{
  "scope": {
    "location": "示例配件仓",
    "channel": "直营商城",
    "window": "日间商品目录",
    "currency": "CNY"
  },
  "minor_digits": 2,
  "crosswalk": "sku-map.csv",
  "layers": {
    "source": {
      "file": "supplier.csv",
      "observed_at": "2026-01-15T12:00:00+08:00",
      "coverage": "complete",
      "identity": "crosswalk",
      "fields": {"id": "item_code", "name": "label", "state": "ready"},
      "states": {"Y": "available", "N": "unavailable"}
    },
    "catalog": {
      "file": "inventory.json",
      "records_path": "data.variants",
      "observed_at": "2026-01-15T12:01:00+08:00",
      "coverage": "complete",
      "identity": "crosswalk",
      "price_unit": "major",
      "fields": {
        "id": "variantId", "name": "title", "state": "channel.active",
        "sale_price_minor": "price.current", "list_price_minor": "price.original"
      },
      "states": {"true": "enabled", "false": "disabled"}
    },
    "storefront": {
      "file": "shop.csv",
      "observed_at": "2026-01-15T12:02:00+08:00",
      "coverage": "complete",
      "identity": "crosswalk",
      "fields": {
        "id": "offer_id", "name": "product_name", "state": "badge",
        "sale_price_minor": "shown_fen", "list_price_minor": "compare_at_fen"
      },
      "states": {"in_stock": "available", "sold_out": "unavailable"}
    }
  }
}
